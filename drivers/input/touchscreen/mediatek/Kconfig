config TOUCHSCREEN_MTK_GT9XX_MZ
	bool "Meizu Goodix GT9xx"
	depends on TOUCHSCREEN_MTK && I2C && OF
	default n
	help
	  Meizu GT9xx driver with explicit board-owned controller resources.
	  Select a supported resource profile and supply its matching firmware.

config TOUCHSCREEN_MTK_GT9XX_U20_STOCK_RESOURCES
	bool "Meizu U20 own-stock GT9xx resources"
	depends on TOUCHSCREEN_MTK_GT9XX_MZ && OF && ARCH_MT6755
	depends on !TOUCHSCREEN_MTK_GT9XX_U10_STOCK_RESOURCES
	default n
	help
	  Use the own U20 named regulator/pinctrl and normal/charger
	  configuration groups. External firmware update files remain
	  owner-provided; no embedded donor firmware is selected.

config TOUCHSCREEN_MTK_GT9XX_U10_STOCK_RESOURCES
	bool "U10 stock DT and MT6353 resources for GT9XX_MZ"
	depends on TOUCHSCREEN_MTK_GT9XX_MZ && OF && REGULATOR
	depends on ARCH_MT6755 && MTK_PMIC_NEW_ARCH = y
	depends on MTK_PMIC_CHIP_MT6353 = y
	default n
	help
	  Use the U10 Goodix DT client (mediatek,cap_touch_gt), logical
	  touch pinctrl states and the MT6353 VLDO28 API recovered from
	  the U10 stock kernel. Requires the U10 touch DT and vtouch supply.
	  Requires privately generated own U10 configuration and firmware
	  headers via GT9XX_U10_PRIVATE_INCLUDE. There is no donor fallback.
	  The complete U10 board port still requires separate validation.
	  Do not enable for M3s, U20, or the existing m681 resource profile.

config TOUCHSCREEN_MTK_GT9XX_M681_LEGACY_RESOURCES
	bool "Meizu M681 legacy GT9xx resource profile"
	depends on TOUCHSCREEN_MTK_GT9XX_MZ && OF && ARCH_MT6755
	default n
	help
	  Allow the legacy M681 resource profile only on an explicitly matching
	  board device tree. It requires owner-provided M681 firmware resources.
	  Do not use this profile for U10 or U20.

config TOUCHSCREEN_MTK_FT5X26
	bool "ELAN3915 for Mediatek package"
	help
	  Touch driver for ft5x26.
	  Say Y here if you use ft5x26 touch panel.

	  If unsure, say N.

source "drivers/input/touchscreen/mediatek/ft5x26/Kconfig"
